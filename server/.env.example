# ── Local development ────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env.

# Port (local dev only — Render sets this automatically)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/mini-ats
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/mini-ats?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mini-ats

# Environment
NODE_ENV=development

# CORS — allowed frontend origins (comma-separated)
# Local dev:  http://localhost:5173
# Render:     not needed (same-origin) — set only if calling the API from a separate domain
ALLOWED_ORIGIN=http://localhost:5173
