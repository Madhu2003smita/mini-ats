# Server port (local dev only — Vercel ignores this)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/mini-ats
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/mini-ats
MONGODB_URI=mongodb://localhost:27017/mini-ats

# Environment
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Vercel:    https://mini-ats.vercel.app  (set this in Vercel dashboard)
ALLOWED_ORIGIN=http://localhost:5173
